.gradle/
build/
local.properties
.idea/
.kotlin/
captures/
*.iml
app/build/

# Secrets — never commit API keys
.env
backend/.env
**/.env

# Large raw dataset dumps (re-downloadable via tools/download_all.py) — do not commit
tools/*.jsonl
tools/*.jsonl.gz

# Python caches / compiled files
__pycache__/
*.pyc

# Runtime logs & DB backups / working copies — do not commit
backend/data/engine_logs.db
backend/data/uploads/
backend/data/*.bak
backend/data/*catalog*backup*.db
backend/data/catalog_filtered.db
backend/data/catalog.db.*

# Ad-hoc local diagnostic scripts
backend/_test_online.py

# JVM crash dumps from the Android build — do not commit
hs_err_pid*.log
replay_pid*.log
