# Copy this file to backend/.env and paste your real keys:
#   copy .env.example .env
#
# backend/.env is gitignored and loaded automatically by server.py.

# ---- Default stack: GPT Realtime Talker if OPENAI_API_KEY exists; Qwen fallback ----
DASHSCOPE_API_KEY=sk-your-dashscope-key

# Talker: auto (GPT first, Qwen fallback) | openai/gpt | qwen
TALKER_PROVIDER=auto

# Ablation switch for interruption-aware context.
# 1 = add [INTERRUPTED] markers and barge-in prompt guidance.
# 0 = keep cancel/truncate behavior, but do not add markers or prompt guidance.
INTERRUPTION_HANDLING_ENABLED=1

# GPT Realtime Talker
OPENAI_API_KEY=sk-your-openai-key
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Local ONNX VAD gate for GPT Realtime audio input.
# When enabled and dependencies are installed, audio is filtered locally before
# sending speech chunks to GPT Realtime. If unavailable, the backend falls back
# to GPT server_vad.
LOCAL_VAD_ENABLED=1
LOCAL_VAD_THRESHOLD=0.5
LOCAL_VAD_TWO_PASS_THRESHOLD=0.4
LOCAL_VAD_MIN_SILENCE_MS=500
LOCAL_VAD_MIN_PAUSE_MS=300
LOCAL_VAD_TWO_PASS=1
LOCAL_VAD_INCOMPLETE_DELAY_ENABLED=1
LOCAL_VAD_INCOMPLETE_DELAY_MS=500
LOCAL_VAD_INCOMPLETE_SHORT_UTTERANCE_MS=1600

# Optional talker audio denoise. Disabled by default because it changes the
# realtime audio/VAD path; turn it on for local experiments after installing or
# pointing to the Krisp wheel.
TALKER_DENOISE_ENABLED=0
TALKER_DENOISE_MODEL=/Users/YukiWang/Downloads/denoise/krisp-viva-tel-lite-v1.kef
TALKER_DENOISE_WHEEL=/Users/YukiWang/Downloads/denoise/krisp_audio-1.6.1-cp312-cp312-macosx_12_0_arm64.whl
TALKER_DENOISE_SUPPRESSION_LEVEL=100

# Qwen Omni Realtime (duplex voice Talker) — use your Workspace host
QWEN_REALTIME_URL=wss://llm-vdpkdeusr5uqy89y.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime
# Generic DashScope (also works, but workspace host is preferred):
# QWEN_REALTIME_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime

QWEN_OMNI_MODEL=qwen3.5-omni-flash-realtime
# QWEN_OMNI_MODEL=qwen3.5-omni-plus-realtime
# Qwen3.5-Omni-Realtime default voice is Tina (Cherry is for older Omni Flash).
QWEN_OMNI_VOICE=Tina
QWEN_ASR_MODEL=qwen3-asr-flash-realtime
QWEN_TURN_DETECTION=server_vad

# Qwen chat (Planner / Recommend Worker / CLI)
QWEN_CHAT_BASE_URL=https://llm-vdpkdeusr5uqy89y.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# Native DashScope REST (generation etc., not used by chat client by default)
# QWEN_DASHSCOPE_BASE_URL=https://llm-vdpkdeusr5uqy89y.cn-beijing.maas.aliyuncs.com/api/v1
QWEN_CHAT_MODEL=qwen-plus

# ---- OpenAI chat (optional) ----
# OPENAI_CHAT_MODEL=gpt-4o-mini
