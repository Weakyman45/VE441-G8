# Copy this file to backend/.env and paste your real keys:
#   copy .env.example .env
#
# backend/.env is gitignored and loaded automatically by server.py.

# ---- Default stack: Qwen (Talker + Planner/Worker LLM) ----
DASHSCOPE_API_KEY=sk-your-dashscope-key

# Talker: qwen (default) | openai (legacy)
TALKER_PROVIDER=qwen

# Qwen Omni Realtime (duplex voice Talker) — use your Workspace host
QWEN_REALTIME_URL=wss://llm-vdpkdeusr5uqy89y.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime
# Generic DashScope (also works, but workspace host is preferred):
# QWEN_REALTIME_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime

QWEN_OMNI_MODEL=qwen3.5-omni-flash-realtime
# QWEN_OMNI_MODEL=qwen3.5-omni-plus-realtime
# Qwen3.5-Omni-Realtime default voice is Tina (Cherry is for older Omni Flash).
QWEN_OMNI_VOICE=Tina
QWEN_ASR_MODEL=qwen3-asr-flash-realtime
QWEN_TURN_DETECTION=server_vad

# Qwen chat (Planner / Recommend Worker / CLI)
QWEN_CHAT_BASE_URL=https://llm-vdpkdeusr5uqy89y.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# Native DashScope REST (generation etc., not used by chat client by default)
# QWEN_DASHSCOPE_BASE_URL=https://llm-vdpkdeusr5uqy89y.cn-beijing.maas.aliyuncs.com/api/v1
QWEN_CHAT_MODEL=qwen-plus

# ---- Legacy OpenAI (optional, unused when TALKER_PROVIDER=qwen) ----
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_REALTIME_MODEL=gpt-realtime
# OPENAI_CHAT_MODEL=gpt-4o-mini
